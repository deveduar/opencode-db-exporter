# opencode-db.conf.example — optional configuration for opencode-db-exporter.
# Copy to ~/.config/opencode-db/opencode-db.conf (permissions 600).
# Paths and preferences only; contains no secrets.
# Any omitted variable uses the default from modules/common.sh.

# Path to the opencode database (default).
# OPENCODE_DB="$HOME/.local/share/opencode/opencode.db"

# Output directories. By default they live under ~/.local/share/opencode-db-exporter/.
# OCED_OUT="$HOME/.local/share/opencode-db-exporter/exports"
# OCED_BACKUP_DIR="$HOME/.local/share/opencode-db-exporter/backups"

# Compress backups with gzip: 1 (yes) or 0 (no). Default 1.
# OCED_COMPRESS=1