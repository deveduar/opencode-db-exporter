# opencode-db.conf.example — optional configuration for opencode-db-exporter.
# Copy to ~/.config/opencode-db/opencode-db.conf (permissions 600).
# Paths and preferences only; contains no secrets.
# Any omitted variable uses the default from modules/common.sh.
# Precedence: environment > this conf file > built-in default (an exported
# variable is never clobbered by this file).

# Path to the opencode database (default).
# OPENCODE_DB="$HOME/.local/share/opencode/opencode.db"

# Output directories. By default they live under ~/.local/share/opencode-db-exporter/.
# OCED_OUT="$HOME/.local/share/opencode-db-exporter/exports"
# OCED_BACKUP_DIR="$HOME/.local/share/opencode-db-exporter/backups"

# Compress backups with gzip: 1 (yes) or 0 (no). Default 1.
# OCED_COMPRESS=1

# Opt-in activity log: 1 appends one timestamped line per significant action
# (backup, prune, shrink) to OCED_ACTIVITY_LOG. Default 0 (no log file).
# OCED_LOG=0
# OCED_ACTIVITY_LOG="$HOME/.local/state/opencode-db/activity.log"

# Named export presets (JSON source of truth for `export <name>` and the menu).
# install.sh auto-creates the file from presets.json.example when missing.
# Example:
# {"presets": {"clean": {"product": "transcript", "json": true, "sanitize": true,
#                          "no_reasoning": true, "filter": "Project Beta"},
#              "everything": {"products": {"transcript": {"json": true, "tool_output": "full"},
#                                          "memory": {"files": true}}}}}
# Keys allowed: product (single) or products (bundle map product->flags) + sub,
# tool_output, patch, role, cap, json, sanitize, files, no_reasoning,
# mark_compactions, summary_diffs, tool_input_limit, tool_output_limit,
# filter (LIKE) or sessions (exact ids). Empty/missing file = no presets.
# OCED_PRESETS="$HOME/.config/opencode-db/presets.json"

# Named shrink presets (JSON source of truth for `shrink <name>` and the menu).
# install.sh auto-creates the file from shrink-presets.json.example when missing.
# The shipped recipes lean/recent/full/bare always exist; this file extends or
# overrides them. Example:
# {"presets": {"lean": {"keep": 10, "strip_reasoning": true},
#              "spring-clean": {"discard_sessions": ["ses_0123", "ses_4567"]}}}
# A preset pins EXACTLY ONE keep rule: keep | older_than | since | keep_all |
# keep_sessions | discard_sessions (+ optional strip_reasoning). Missing file =
# built-in recipes only. `shrink --list-presets` shows the effective set.
# OCED_SHRINK_PRESETS="$HOME/.config/opencode-db/shrink-presets.json"