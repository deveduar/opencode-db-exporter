{
  "presets": {
    "archive": {
      "products": {
        "transcript": {"json": true, "tool_output": "full"},
        "memory": {"files": true}
      }
    },
    "quick": {
      "products": {
        "transcript": {"json": true, "tool_output": "truncated"},
        "memory": {"files": true}
      }
    },
    "share": {
      "product": "transcript",
      "json": true,
      "no_reasoning": true
    },
    "notes": {
      "product": "transcript"
    },
    "rag": {
      "product": "memory"
    },
    "digest": {
      "product": "digest"
    },
    "backup_then_full": {
      "product": "transcript",
      "snapshot": "fresh",
      "tool_output": "full"
    },
    "one_session": {
      "product": "memory",
      "sessions": ["ses_ONLY_THIS_ID"]
    },
    "this_week": {
      "product": "transcript",
      "filter": "%2026-09%"
    }
  }
}