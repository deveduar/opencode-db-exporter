{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode-db-exporter.local/schemas/presets.schema.json",
  "title": "opencode-db presets.json",
  "description": "Contract for the OCED_PRESETS file, the source of truth for `opencode-db export <name>` and the export menu. A preset is either a single product (key `product`) or a bundle of products under one stamp (key `products`). Full schema notes and the other contracts live in docs/schemas.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["presets"],
  "properties": {
    "presets": {
      "type": "object",
      "description": "Name -> preset. Names conflict with product keywords (transcript|memory|compactions|full) are allowed as data, but `export <name>` always resolves a keyword first.",
      "additionalProperties": { "$ref": "#/definitions/preset" }
    }
  },
  "definitions": {
    "nonNegInt": { "type": "integer", "minimum": 0 },
    "bool":     { "type": "boolean" },
    "filter":   { "type": "string", "minLength": 1, "description": "SQL LIKE pattern on session id/title (session selection)." },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "description": "Exact session ids (session selection; exclusive with a preset 'filter').",
      "items": { "type": "string", "minLength": 1 }
    },
    "flagSub":          { "type": "string", "enum": ["separate", "inline", "omit"] },
    "flagToolOutput":   { "type": "string", "enum": ["full", "truncated", "omit"] },
    "flagPatch":        { "type": "string", "enum": ["full", "omit"] },
    "flagRole":         { "type": "string", "enum": ["all", "user", "assistant"] },
    "flagJson":         { "$ref": "#/definitions/bool", "description": "transcript/compactions: write a faithful JSON archive per session." },
    "flagSanitize":     { "$ref": "#/definitions/bool", "description": "redact secret-looking values in memory before serializing." },
    "flagNoReasoning":  { "$ref": "#/definitions/bool", "description": "transcript: omit the reasoning parts." },
    "flagMarkCompactions": { "$ref": "#/definitions/bool" },
    "flagSummaryDiffs": { "$ref": "#/definitions/bool" },
    "flagFiles":        { "$ref": "#/definitions/bool", "description": "memory: include touched files per session." },
    "flagCap":          { "$ref": "#/definitions/nonNegInt", "description": "memory: truncate each text value to N chars (0 = unlimited)." },
    "flagToolInputLimit":  { "$ref": "#/definitions/nonNegInt" },
    "flagToolOutputLimit": { "$ref": "#/definitions/nonNegInt" },

    "flagProps": {
      "description": "Config flags accepted (single: at the preset's top level; bundle: per product). Product-flags that do not affect a product (e.g. cap/files on transcript, json on memory) are ignored.",
      "type": "object",
      "properties": {
        "sub":                 { "$ref": "#/definitions/flagSub" },
        "tool_output":         { "$ref": "#/definitions/flagToolOutput" },
        "tool_input_limit":    { "$ref": "#/definitions/flagToolInputLimit" },
        "tool_output_limit":   { "$ref": "#/definitions/flagToolOutputLimit" },
        "patch":               { "$ref": "#/definitions/flagPatch" },
        "role":                { "$ref": "#/definitions/flagRole" },
        "no_reasoning":        { "$ref": "#/definitions/flagNoReasoning" },
        "mark_compactions":    { "$ref": "#/definitions/flagMarkCompactions" },
        "summary_diffs":       { "$ref": "#/definitions/flagSummaryDiffs" },
        "json":                { "$ref": "#/definitions/flagJson" },
        "sanitize":            { "$ref": "#/definitions/flagSanitize" },
        "files":               { "$ref": "#/definitions/flagFiles" },
        "cap":                 { "$ref": "#/definitions/flagCap" }
      }
    },

    "selectionProps": {
      "description": "Shared session selection (filter LIKE or exact sessions, never both; a CLI --filter/--sessions voids it).",
      "type": "object",
      "properties": {
        "filter":   { "$ref": "#/definitions/filter" },
        "sessions": { "$ref": "#/definitions/sessions" }
      },
      "not": { "required": ["filter", "sessions"] }
    },

    "preset": {
      "oneOf": [
        {
          "title": "single-product preset",
          "type": "object",
          "additionalProperties": false,
          "required": ["product"],
          "properties": {
            "product": { "type": "string", "enum": ["transcript", "memory", "compactions"],
                         "description": "full is a CLI alias, not a preset product." },
            "sub":                 { "$ref": "#/definitions/flagSub" },
            "tool_output":         { "$ref": "#/definitions/flagToolOutput" },
            "tool_input_limit":    { "$ref": "#/definitions/flagToolInputLimit" },
            "tool_output_limit":   { "$ref": "#/definitions/flagToolOutputLimit" },
            "patch":               { "$ref": "#/definitions/flagPatch" },
            "role":                { "$ref": "#/definitions/flagRole" },
            "no_reasoning":        { "$ref": "#/definitions/flagNoReasoning" },
            "mark_compactions":    { "$ref": "#/definitions/flagMarkCompactions" },
            "summary_diffs":       { "$ref": "#/definitions/flagSummaryDiffs" },
            "json":                { "$ref": "#/definitions/flagJson" },
            "sanitize":            { "$ref": "#/definitions/flagSanitize" },
            "files":               { "$ref": "#/definitions/flagFiles" },
            "cap":                 { "$ref": "#/definitions/flagCap" },
            "filter":              { "$ref": "#/definitions/filter" },
            "sessions":            { "$ref": "#/definitions/sessions" }
          },
          "not": { "required": ["filter", "sessions"] }
        },
        {
          "title": "bundle preset",
          "type": "object",
          "additionalProperties": false,
          "required": ["products"],
          "properties": {
            "products": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "patternProperties": {
                "^(transcript|memory|compactions)$": {
                  "type": "object",
                  "description": "Per-product flags; the selection (top level) is shared by every product.",
                  "additionalProperties": false,
                  "properties": {
                    "sub":                 { "$ref": "#/definitions/flagSub" },
                    "tool_output":         { "$ref": "#/definitions/flagToolOutput" },
                    "tool_input_limit":    { "$ref": "#/definitions/flagToolInputLimit" },
                    "tool_output_limit":   { "$ref": "#/definitions/flagToolOutputLimit" },
                    "patch":               { "$ref": "#/definitions/flagPatch" },
                    "role":                { "$ref": "#/definitions/flagRole" },
                    "no_reasoning":        { "$ref": "#/definitions/flagNoReasoning" },
                    "mark_compactions":    { "$ref": "#/definitions/flagMarkCompactions" },
                    "summary_diffs":       { "$ref": "#/definitions/flagSummaryDiffs" },
                    "json":                { "$ref": "#/definitions/flagJson" },
                    "sanitize":            { "$ref": "#/definitions/flagSanitize" },
                    "files":               { "$ref": "#/definitions/flagFiles" },
                    "cap":                 { "$ref": "#/definitions/flagCap" }
                  }
                }
              }
            },
            "filter":              { "$ref": "#/definitions/filter" },
            "sessions":            { "$ref": "#/definitions/sessions" }
          },
          "not": {
            "title": "selection may use filter or sessions, not both",
            "required": ["filter", "sessions"]
          }
        }
      ]
    }
  }
}